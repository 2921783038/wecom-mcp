# ===== 企业微信应用凭据（必填）=====
# 我的企业 → 企业信息 → 企业 ID
WECOM_CORP_ID=
# 应用管理 → 自建应用 → AgentId
WECOM_AGENT_ID=
# 同上 → Secret
WECOM_SECRET=

# ===== HTTP 模式下的客户端令牌（stdio 模式不需要）=====
# 生成方式：python -c "import secrets;print(secrets.token_hex(16))"
WECOM_MCP_TOKEN=

# ===== HTTP 监听地址 =====
# 只在本机反代时保持 127.0.0.1，不要直接暴露到公网
MCP_HOST=127.0.0.1
MCP_PORT=18131

# ===== 语音合成（可选，只有 send_voice 需要）=====
# 不填时 send_voice 会返回明确提示，其余工具不受影响。
# 服务器还需安装 ffmpeg：apt install ffmpeg
MINIMAX_API_KEY=
MINIMAX_VOICE_ID=
